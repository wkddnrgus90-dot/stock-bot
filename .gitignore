# =============================================
# 보안 / 민감 정보
# =============================================
.env                        # API 키 등 민감 정보 (절대 커밋 금지)
google-credentials.json     # Google 서비스 계정 키 (절대 커밋 금지)
*-credentials.json          # 기타 인증 JSON

# =============================================
# 각 PC에서 별도 관리하는 로컬 데이터
# =============================================
seen_articles.json      # 중복 필터링용 기사 목록 (PC별 독립 관리)
feedback_store.json     # 👍/👎 피드백 누적 데이터 (PC별 독립 관리)
bot.log                 # 실행 로그

