# =============================================
# 주식 뉴스 봇 환경 변수 설정 파일
# =============================================
# 이 파일을 복사해서 .env 로 만들고 실제 값을 입력하세요.
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# =============================================

# [1] Google Gemini API 키
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=여기에입력

# [2] 텔레그램 봇 토큰
# 발급: 텔레그램 → @BotFather → /newbot
TELEGRAM_BOT_TOKEN=여기에입력

# [3] 텔레그램 채팅 ID
# 확인: 봇과 대화 후 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat.id 조회
# 개인 채팅: 숫자 / 그룹: -로 시작하는 숫자
TELEGRAM_CHAT_ID=여기에입력

# [4] Google Sheets 스프레드시트 ID
# 구글 시트 URL에서 복사:
#   https://docs.google.com/spreadsheets/d/[여기가 ID]/edit
GOOGLE_SHEET_ID=여기에입력

# [5] Google 서비스 계정 인증 JSON 파일 경로
# 기본값: 프로젝트 폴더 안의 google-credentials.json
# 설정 방법은 README.md 참고
GOOGLE_CREDENTIALS_FILE=google-credentials.json
