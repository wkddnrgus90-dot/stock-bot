# =============================================
# 주식 뉴스 봇 환경 변수 설정 파일
# =============================================
# 이 파일을 복사하여 .env 파일을 만들고
# 각 항목에 실제 값을 입력하세요.
#
# cp .env.example .env
# =============================================

# Google Gemini API 키
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=여기에입력

# 텔레그램 봇 토큰
# 발급: @BotFather 에서 /newbot 명령어로 생성
TELEGRAM_BOT_TOKEN=여기에입력

# 텔레그램 채팅 ID
# 확인: 봇과 대화 후 https://api.telegram.org/bot<TOKEN>/getUpdates 로 조회
# 개인 채팅이면 숫자, 그룹이면 -로 시작하는 숫자
TELEGRAM_CHAT_ID=여기에입력
